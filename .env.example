# Kopier til .env.local når ekte tjenester skal tas i bruk. M4–M9 bruker Supabase og OpenAI; automatiske tester bruker mocks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig nøkkel: kun på serveren. Aldri bruk NEXT_PUBLIC_ foran denne.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Felles rimelig modell for lærer, helt kapittel, separat kontroll og oppsummering.
# Gammelt OPENAI_MODEL_TUTOR/FAST/REFLECT brukes ikke lenger av tekstprovideren.
# Tom/utelatt verdi bruker gpt-5-mini. Ingen automatisk oppgradering til dyrere modell.
OPENAI_MODEL_DEFAULT=gpt-5-mini
# Egen talemodell for naturlig opplesing med lav kostnad.
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# Tydelig og rolig stemme; norsk uttale skal vurderes før bruk av barn.
OPENAI_TTS_VOICE=marin
# Rimelig transkripsjon av korte talesvar.
OPENAI_MODEL_STT=gpt-4o-mini-transcribe
# Øvre månedsgrense for anslått KI-forbruk per husholdning i norske kroner.
AI_MONTHLY_BUDGET_NOK=100

# Valgfri overstyring. Tom verdi bruker forespørselens adresse eller VERCEL_URL.
# Hvis satt: hele nettadressen, for eksempel https://leo.example.no.
APP_URL=

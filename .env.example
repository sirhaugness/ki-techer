# Kopier til .env.local når ekte tjenester skal tas i bruk. Ingen nøkler trengs i M0.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig nøkkel: kun på serveren. Aldri bruk NEXT_PUBLIC_ foran denne.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Sterk modell for pedagogiske valg, dialog og verktøykall.
OPENAI_MODEL_TUTOR=gpt-5.2
# Rimeligere og raskere modell for korte, avgrensede oppgaver.
OPENAI_MODEL_FAST=gpt-5-mini
# Sterk modell for grundig oppsummering og refleksjon etter økten.
OPENAI_MODEL_REFLECT=gpt-5.2
# Egen talemodell for naturlig opplesing med lav kostnad.
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# Tydelig og rolig stemme; norsk uttale skal vurderes før bruk av barn.
OPENAI_TTS_VOICE=marin
# Rimelig transkripsjon av korte talesvar.
OPENAI_MODEL_STT=gpt-4o-mini-transcribe
# Forslag til månedlig kostnadsgrense i norske kroner.
AI_MONTHLY_BUDGET_NOK=100
